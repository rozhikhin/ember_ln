<h1>Спикеры</h1>

{{#link-to 'speaker-new'}}Добавить спикера{{/link-to}}

<table>
    <thead>
        <tr>
            <th>Имя</th>
            <th>Специализация</th>
            <th>Биография</th>
            <th>Страна</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        {{#each model as |speaker|}}
            <tr>
                <td>{{speaker.name}}</td>
                <td>{{speaker.specialization}}</td>
                <td>{{speaker.bio}}</td>
                <td>{{speaker.country}}</td>
                <td>{{#link-to 'speaker-edit' speaker.id}}Редактировать{{/link-to}} | <a href="#" {{action 'deleteSpeaker' speaker}}>Удалить</a></td>
            </tr>
        {{/each}}
    </tbody>
</table>
