<div class="page-header clearfix">
  <h1 class="pull-left">Спикеры</h1>
  <div class="pull-right" style="margin-top: 25px;">
    {{#link-to "speaker-new" class="btn btn-success"}}
      <span class="glyphicon glyphicon-plus"></span> Добавить спикера
    {{/link-to}}
  </div>
</div>

<div class="panel panel-default">
  <div class="panel-body">
    <div class="row">
      <div class="col-sm-10">
        <div class="form-group" style="margin-bottom: 0;">
          <label>Поиск по всем полям</label>
          {{input class="form-control" value=q input=(action "updateQ" value="target.value") placeholder="Имя, специализация, биография, страна..."}}
        </div>
      </div>
      <div class="col-sm-2">
        <label>&nbsp;</label>
        <button class="btn btn-default btn-block" {{action "clearSearch"}}>Сбросить</button>
      </div>
    </div>
  </div>
</div>

<table class="table table-striped table-bordered table-hover">
  <thead>
    <tr>
      <th>Имя</th>
      <th>Специализация</th>
      <th>Биография</th>
      <th>Страна</th>
      <th class="text-center" style="width: 200px;">Действия</th>
    </tr>
  </thead>
  <tbody>
    {{#each model as |speaker|}}
      <tr>
        <td>{{speaker.name}}</td>
        <td>{{speaker.specialization}}</td>
        <td>{{speaker.bio}}</td>
        <td>{{speaker.country}}</td>
        <td class="text-center">
          {{#link-to "speaker-edit" speaker.id class="btn btn-primary btn-xs"}}
            Редактировать
          {{/link-to}}
          <button class="btn btn-danger btn-xs" {{action "deleteSpeaker" speaker}}>
            Удалить
          </button>
        </td>
      </tr>
    {{else}}
      <tr>
        <td colspan="5" class="text-center text-muted">Спикеры не найдены</td>
      </tr>
    {{/each}}
  </tbody>
</table>
