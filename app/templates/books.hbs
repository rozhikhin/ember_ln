{{#link-to "book-new"}}Добавить книгу{{/link-to}}
<table>
  <thead>
    <tr>
      <th>Название</th>
      <th>Автор</th>
      <th>Год</th>
      <th>Жанр</th>
      <th>Спикер</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    {{#each model as |book|}}
      <tr>
        <td>{{book.title}}</td>
        <td>{{book.author}}</td>
        <td>{{book.year}}</td>
        <td>{{book.genre}}</td>
        <td>{{book.speaker.name}}</td>
        <td>
          {{#link-to "book-edit" book.id}}Редактировать{{/link-to}}
          <button {{action "deleteBook" book}}>Удалить</button>
        </td>
      </tr>
    {{/each}}
  </tbody>
</table>
