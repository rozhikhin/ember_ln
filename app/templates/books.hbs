<div class="page-header clearfix">
  <h1 class="pull-left">Книги</h1>
  <div class="pull-right" style="margin-top: 25px;">
    {{#link-to "book-new" class="btn btn-success"}}
      <span class="glyphicon glyphicon-plus"></span> Добавить книгу
    {{/link-to}}
  </div>
</div>

<div class="panel panel-default">
  <div class="panel-body">
    <div class="row">
      <div class="col-sm-5">
        <div class="form-group" style="margin-bottom: 0;">
          <label>Поиск по всем полям</label>
          {{input class="form-control" value=q input=(action "updateQ" value="target.value") placeholder="Название, автор, жанр..."}}
        </div>
      </div>
      <div class="col-sm-5">
        <div class="form-group" style="margin-bottom: 0;">
          <label>Поиск по тегам</label>
          {{input class="form-control" value=tags input=(action "updateTags" value="target.value") placeholder="sci-fi, fantasy..."}}
        </div>
      </div>
      <div class="col-sm-2">
        <label>&nbsp;</label>
        <button class="btn btn-default btn-block" {{action "clearSearch"}}>Сбросить</button>
      </div>
    </div>
  </div>
</div>

<table class="table table-striped table-bordered table-hover">
  <thead>
    <tr>
      <th>Название</th>
      <th>Автор</th>
      <th>Год</th>
      <th>Жанр</th>
      <th>Теги</th>
      <th>Спикер</th>
      <th class="text-center" style="width: 200px;">Действия</th>
    </tr>
  </thead>
  <tbody>
    {{#each model as |book|}}
      <tr>
        <td>{{book.title}}</td>
        <td>{{book.author}}</td>
        <td>{{book.year}}</td>
        <td>{{book.genre}}</td>
        <td>
          {{#each (split-tags book.tags) as |tag|}}
            {{#link-to "books" (query-params tags=tag) class="label label-success"}}
              {{tag}}
            {{/link-to}} &nbsp;
          {{else}}
            <span class="text-muted">—</span>
          {{/each}}
        </td>
        <td>{{book.speaker.name}}</td>
        <td class="text-center">
          {{#link-to "book-edit" book.id class="btn btn-primary btn-xs"}}
            Редактировать
          {{/link-to}}
          <button class="btn btn-danger btn-xs" {{action "deleteBook" book}}>
            Удалить
          </button>
        </td>
      </tr>
    {{else}}
      <tr>
        <td colspan="7" class="text-center text-muted">Книги не найдены</td>
      </tr>
    {{/each}}
  </tbody>
</table>
